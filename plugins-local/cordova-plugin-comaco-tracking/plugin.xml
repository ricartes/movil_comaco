<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
    xmlns:android="http://schemas.android.com/apk/res/android"
    id="cordova-plugin-comaco-tracking" version="1.1.0">
    <name>ComacoTracking</name>
    <description>Seguimiento GPS nativo y durable para COMACO.</description>
    <js-module src="www/ComacoTracking.js" name="ComacoTracking">
        <clobbers target="ComacoTracking" />
    </js-module>

    <platform name="android">
        <framework
            src="src/android/comaco-kotlin-alignment.gradle"
            custom="true"
            type="gradleReference" />
        <framework src="androidx.core:core:1.13.1" />
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="ComacoTracking">
                <param name="android-package"
                    value="io.gestionasi.comaco.tracking.ComacoTrackingPlugin" />
            </feature>
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
            <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
            <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
            <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
            <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
            <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
        </config-file>
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <service android:name="io.gestionasi.comaco.tracking.TrackingForegroundService"
                android:exported="false"
                android:stopWithTask="false"
                android:foregroundServiceType="location" />
            <service android:name="io.gestionasi.comaco.tracking.DeviceAuditJobService"
                android:exported="false"
                android:permission="android.permission.BIND_JOB_SERVICE" />
            <receiver android:name="io.gestionasi.comaco.tracking.TrackingBootReceiver"
                android:enabled="true" android:exported="true">
                <intent-filter>
                    <action android:name="android.intent.action.BOOT_COMPLETED" />
                    <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                </intent-filter>
            </receiver>
        </config-file>
        <source-file src="src/android/ComacoTrackingPlugin.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/TrackingForegroundService.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/TrackingBootReceiver.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/PowerPolicyInspector.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/TrackingHealthMonitor.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/TrackingStore.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/CredentialCipher.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/TrackingUploader.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/DeviceAuditCanonicalizer.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/DeviceAuditStore.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/DeviceAuditUploader.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/DeviceAuditCoordinator.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
        <source-file src="src/android/DeviceAuditJobService.java"
            target-dir="app/src/main/java/io/gestionasi/comaco/tracking" />
    </platform>
    <platform name="browser">
        <js-module src="src/browser/ComacoTracking.js" name="ComacoTrackingBrowser">
            <runs />
        </js-module>
    </platform>
</plugin>
