{
    "name": "gdefds",
    "private": true,
    "version": "1.0.0",
    "description": "GdeFds",
    "repository": "",
    "license": "UNLICENSED",
    "scripts": {
        "start": "npm run dev",
        "dev": "cross-env NODE_ENV=development vite",
        "build": "cross-env NODE_ENV=production vite build",
        "build-capacitor-android": "cross-env NODE_ENV=production vite build && npx cap copy android",
        "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/",
        "run-android": "cross-env NODE_ENV=production vite build && npx cap copy android && npx cap run android"
    },
    "browserslist": [
        "IOS >= 15",
        "Safari >= 15",
        "last 5 Chrome versions",
        "last 5 Firefox versions"
    ],
    "dependencies": {
        "@capacitor-community/file-opener": "^7.0.1",
        "@capacitor-firebase/crashlytics": "^7.3.1",
        "@capacitor-firebase/messaging": "^7.3.1",
        "@capacitor/android": "7.4.4",
        "@capacitor/app": "^7.1.0",
        "@capacitor/browser": "^7.0.2",
        "@capacitor/core": "7.4.4",
        "@capacitor/device": "^7.0.2",
        "@capacitor/file-viewer": "1.0.5",
        "@capacitor/filesystem": "^7.1.4",
        "@capacitor/geolocation": "^7.1.5",
        "@capacitor/keyboard": "^7.0.3",
        "@capacitor/network": "^7.0.2",
        "@capacitor/preferences": "^7.0.2",
        "@capacitor/push-notifications": "^7.0.3",
        "@capacitor/share": "^7.0.2",
        "@capacitor/splash-screen": "^7.0.3",
        "@capacitor/status-bar": "^7.0.3",
        "@capawesome-team/capacitor-android-foreground-service": "^7.0.1",
        "@turf/boolean-point-in-polygon": "^7.2.0",
        "@turf/helpers": "^7.2.0",
        "bwip-js": "^4.7.0",
        "chart.js": "^4.5.1",
        "cordova-plugin-android-permissions": "^1.1.5",
        "cordova-plugin-btprinter": "github:ricartes/Cordova-Plugin-BTPrinter",
        "dayjs": "^1.11.18",
        "dom7": "^4.0.6",
        "firebase": "^11.10.0",
        "framework7": "^8.3.4",
        "framework7-icons": "^5.0.5",
        "framework7-vue": "^8.3.4",
        "material-icons": "^1.13.14",
        "node-forge": "^1.3.1",
        "pdfmake": "^0.2.20",
        "skeleton-elements": "^4.0.1",
        "swiper": "^11.2.10",
        "uuid": "^13.0.0",
        "vue": "^3.5.21"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "7.4.4",
        "@vitejs/plugin-vue": "^6.0.1",
        "@vue/compiler-sfc": "^3.5.21",
        "cordova-res": "^0.15.4",
        "cpy-cli": "^6.0.0",
        "cross-env": "10.1.0",
        "less": "4.4.2",
        "postcss-preset-env": "^10.3.1",
        "vite": "7.1.12"
    },
    "overrides": {
        "sharp": "^0.33.5",
        "@img/sharp-darwin-arm64": "^0.33.5",
        "@img/sharp-linux-x64": "^0.33.5",
        "@img/sharp-win32-x64": "^0.33.5"
    }
}
