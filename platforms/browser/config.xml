<?xml version='1.0' encoding='utf-8'?>
<widget id="io.gestionasi.gfe_comaco" version="9100" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Control de Origen (Proveedores)</name>
    <description>
        Emisión guia electronica Proveedores Comaco
    </description>
    <author email="aandaur@gestionasi.cl" href="http://cordova.io">
       GESTIONASI
    </author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <hook src="node_modules/cordova-import-npm/scripts/importNpmPackages.js" type="before_prepare" />
    <preference name="AndroidInsecureFileModeEnabled" value="true" />
    <preference name="android-targetSdkVersion" value="31" />
</widget>
